# Public site URL (used for canonical URLs, sitemap and schema)
NEXT_PUBLIC_SITE_URL=https://tridentsquare.com

# Contact details shown on the site and in structured data
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE_E164=916388443418
NEXT_PUBLIC_CONTACT_PHONE_DISPLAY=+91 63884 43418

# Google Search Console HTML-tag verification code (content="..." value only)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Lead delivery — set at least one in production.
# Recommended (free): Google Sheet + email via docs/google-sheet-leads.gs (setup steps are in that file).
# Also accepts any JSON webhook: Slack/Discord, Zapier, Make, n8n.
LEAD_WEBHOOK_URL=
# Shared secret sent to the webhook as `token`; must match SECRET in the Apps Script
LEAD_WEBHOOK_SECRET=
# Email via Resend (https://resend.com)
RESEND_API_KEY=
LEAD_TO_EMAIL=
LEAD_FROM_EMAIL=Trident Square Website <leads@tridentsquare.com>
