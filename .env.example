# Public contact details (exposed to the browser — do not put secrets here).
# Copy to `.env.local` and fill in. Restart the dev server after changes.

NEXT_PUBLIC_CONTACT_EMAIL=you@example.com

# WhatsApp and tel: — digits only, with country code, no spaces or +
NEXT_PUBLIC_CONTACT_PHONE_E164=911234567890

# Optional: how the number appears on the site (e.g. +91 12345 67890)
NEXT_PUBLIC_CONTACT_PHONE_DISPLAY=
